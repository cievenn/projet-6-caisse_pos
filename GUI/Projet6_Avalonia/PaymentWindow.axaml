<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Projet6_Avalonia.PaymentWindow"
        Title="Encaisser" Width="400" Height="250" 
        WindowStartupLocation="CenterOwner"
        Background="#141519"
        CanResize="False"
        FontFamily="Segoe UI, system-ui, sans-serif">
    
    <Border Background="#22252E" CornerRadius="16" Margin="15" BoxShadow="0 8 20 0 #40000000" Padding="30">
        <StackPanel Spacing="20">
            <TextBlock Text="Montant donné par le client (€)" FontSize="16" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
            
            <TextBox Name="TxtAmount" FontSize="32" FontWeight="Bold" TextAlignment="Center" 
                     HorizontalAlignment="Stretch" Padding="15" CornerRadius="12" Background="#141519" Foreground="#00E5FF" BorderThickness="1" BorderBrush="#323644"/>
            
            <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
                <Button Grid.Column="0" Content="✔️ VALIDER" Click="BtnValider_Click"
                        Background="#00FF87" Foreground="#141519" FontWeight="Black" FontSize="16"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0" CornerRadius="10" Padding="15"/>
                
                <Button Grid.Column="1" Content="❌ ANNULER" Click="BtnCancel_Click"
                        Background="#4A1C20" Foreground="#FF4D4D" FontWeight="Bold" FontSize="16"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0" CornerRadius="10" Padding="15"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>