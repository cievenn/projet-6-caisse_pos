<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Projet6_Avalonia.PaymentWindow"
        Title="Paiement Client" Width="300" Height="150" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Montant donné par le client (€) :"/>
        <TextBox Name="TxtAmount" />
        <Grid ColumnDefinitions="*, *" Margin="0,10,0,0">
            <Button Grid.Column="0" Content="Valider" Background="#2ecc71" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="BtnValider_Click"/>
            <Button Grid.Column="1" Content="Annuler" Background="#e74c3c" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="BtnCancel_Click" Margin="10,0,0,0"/>
        </Grid>
    </StackPanel>
</Window>