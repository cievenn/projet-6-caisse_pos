<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Projet6_Avalonia.PaymentWindow"
        Title="Paiement" Width="400" Height="280" 
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        CanResize="False"
        FontFamily="Segoe UI, system-ui, sans-serif">
    
    <Panel>
        <!-- Arrière-plan statique clair si Mica n'est pas géré par l'OS -->
        <Border Background="#F1F5F9" />
        
        <Border Background="#B3FFFFFF" CornerRadius="20" Margin="20" BoxShadow="0 10 30 0 #15000000" Padding="30" BorderBrush="#FFFFFFFF" BorderThickness="1.5">
            <StackPanel Spacing="20">
                <TextBlock Text="Montant reçu" FontSize="20" FontWeight="Black" Foreground="#1E293B" HorizontalAlignment="Center"/>
                
                <TextBox Name="TxtAmount" FontSize="32" FontWeight="Bold" TextAlignment="Center" 
                         HorizontalAlignment="Stretch" Padding="15" CornerRadius="12" Background="#FFFFFF" Foreground="#FF4A4A" BorderBrush="#CBD5E1"/>
                
                <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
                    <Button Grid.Column="0" Content="Valider" Click="BtnValider_Click"
                            Background="#FF4A4A" Foreground="White" FontWeight="Bold" FontSize="16"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0" CornerRadius="12" Padding="12"/>
                    
                    <Button Grid.Column="1" Content="Annuler" Click="BtnCancel_Click"
                            Background="Transparent" BorderBrush="#1E293B" BorderThickness="1" Foreground="#1E293B" FontWeight="Bold" FontSize="16"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0" CornerRadius="12" Padding="12"/>
                </Grid>
            </StackPanel>
        </Border>
    </Panel>
</Window>