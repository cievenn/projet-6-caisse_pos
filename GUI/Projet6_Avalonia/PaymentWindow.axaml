<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Projet6_Avalonia.PaymentWindow"
        Title="Paiement" Width="400" Height="300" 
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        CanResize="False"
        FontFamily="Segoe UI, system-ui, sans-serif">
    
    <Panel>
        <!-- Fond neutre doux -->
        <Border Background="#F8F6F4" />
        
        <Border Background="#E8FFFFFF" CornerRadius="20" Margin="20" 
                BoxShadow="0 10 30 0 #15000000" Padding="30">
            <StackPanel Spacing="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="💳" FontSize="24"/>
                    <TextBlock Text="Montant reçu" FontSize="22" FontWeight="Black" Foreground="#1E293B"/>
                </StackPanel>
                
                <TextBox Name="TxtAmount" FontSize="32" FontWeight="Bold" TextAlignment="Center" 
                         HorizontalAlignment="Stretch" Padding="15" CornerRadius="12" 
                         Background="#FFFFFF" Foreground="#FF6347" 
                         BorderBrush="#E2E8F0" BorderThickness="1"
                         Watermark="0.00"/>
                
                <Grid ColumnDefinitions="*, *" Margin="0,10,0,0">
                    <Button Grid.Column="0" Content="✅  Valider" Click="BtnValider_Click"
                            Background="#FF6347" Foreground="White" FontWeight="Bold" FontSize="16"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                            Margin="0,0,5,0" CornerRadius="12" Padding="14"/>
                    
                    <Button Grid.Column="1" Content="Annuler" Click="BtnCancel_Click"
                            Background="#F1F5F9" Foreground="#64748B" FontWeight="SemiBold" FontSize="16"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                            Margin="5,0,0,0" CornerRadius="12" Padding="14" BorderThickness="0"/>
                </Grid>
            </StackPanel>
        </Border>
    </Panel>
</Window>