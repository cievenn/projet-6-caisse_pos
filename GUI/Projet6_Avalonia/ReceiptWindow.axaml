<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Projet6_Avalonia.ReceiptWindow"
        Title="Ticket de Caisse" Width="380" Height="520" 
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        CanResize="False"
        FontFamily="Segoe UI, system-ui, sans-serif">
    
    <Panel>
        <!-- Fond doux -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#FFECD2" Offset="0.0"/>
                    <GradientStop Color="#FCB69F" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Ticket principal -->
        <Border Background="#F0FFFFFF" CornerRadius="24" Margin="16" 
                BoxShadow="0 10 40 0 #20000000" Padding="0" 
                BorderBrush="#FF6347" BorderThickness="2">
            <Grid RowDefinitions="Auto, Auto, *, Auto, Auto, Auto">

                <!-- Header du ticket -->
                <Border Grid.Row="0" Background="#FF6347" CornerRadius="22,22,0,0" Padding="20,18">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="🛒 MON PETIT COMMERCE" FontSize="16" FontWeight="Black" 
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Name="LblDate" Text="" FontSize="11" Foreground="#FFD4C4" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Name="LblTransId" Text="" FontSize="11" Foreground="#FFD4C4" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Séparateur pointillé -->
                <Border Grid.Row="1" Height="2" Margin="20,0" Opacity="0.3">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#FF6347" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.5"/>
                            <GradientStop Color="#FF6347" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Zone de défilement pour les détails -->
                <ScrollViewer Grid.Row="2" Margin="20,10,20,5">
                    <StackPanel Name="PanelDetails" Spacing="4"/>
                </ScrollViewer>

                <!-- Séparateur -->
                <Border Grid.Row="3" Height="1" Background="#20FF6347" Margin="20,5"/>

                <!-- Totaux -->
                <StackPanel Grid.Row="4" Margin="20,8,20,5" Spacing="6">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="TOTAL TTC" FontWeight="Black" FontSize="16" Foreground="#1E293B"/>
                        <TextBlock Grid.Column="1" Name="LblTotal" Text="0.00 €" FontWeight="Black" FontSize="20" Foreground="#FF6347"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Payé" FontSize="13" Foreground="#94A3B8"/>
                        <TextBlock Grid.Column="1" Name="LblPaid" Text="0.00 €" FontSize="13" Foreground="#94A3B8"/>
                    </Grid>
                    <Border Background="#15FF6347" CornerRadius="10" Padding="12,8" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="💰 À rendre" FontWeight="Bold" FontSize="14" Foreground="#FF6347" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Name="LblChange" Text="0.00 €" FontWeight="Black" FontSize="18" Foreground="#FF6347"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Détail rendu monnaie + Footer -->
                <StackPanel Grid.Row="5" Margin="20,5,20,15" Spacing="6">
                    <StackPanel Name="PanelChangeDetail" Spacing="2"/>
                    <Border Height="1" Background="#10000000" Margin="0,4"/>
                    <TextBlock Text="Merci de votre visite ! 🙏" FontSize="13" FontWeight="SemiBold" 
                               Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Panel>
</Window>